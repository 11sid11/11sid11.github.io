---
import ProductPreview from '@/components/ProductPreview.astro';
import type { DevProject } from '@/data/projects';

interface Props {
  project: DevProject;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const statusLabel = project.status === 'shipped' ? 'SHIPPED' : project.status === 'active' ? 'ACTIVE' : 'CURRENT BUILD';
const primary = project.links.find((link) => link.kind === 'live') ?? project.links[0];
---
<article class:list={['project-card', `tone-${project.tone}`]} data-scroll-progress="viewport">
  <div class="project-card-surface" aria-hidden="true"></div>
  <div class="project-card-grid">
    <div class="project-index">{String(index + 1).padStart(2, '0')}</div>
    <div class="project-card-body">
      <div class="project-card-topline">
        <span>{project.eyebrow}</span>
        <span class="status-pill">{statusLabel}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <ul class="tag-row" aria-label="Technology stack">
        {project.stack.slice(0, 4).map((item) => <li>{item}</li>)}
      </ul>
      {project.note && <div class="project-note">// {project.note}</div>}
      <div class="project-card-actions">
        {primary && (
          <a href={primary.href} target="_blank" rel="noreferrer" data-live-link>
            {primary.kind === 'live' ? 'OPEN PRODUCT ↗' : primary.label.toUpperCase() + ' ↗'}
          </a>
        )}
        <a href={`/dev/${project.slug}/`} data-case-link>CASE NOTES →</a>
      </div>
    </div>
    <a
      class="project-card-preview"
      href={primary?.href ?? `/dev/${project.slug}/`}
      target={primary ? '_blank' : undefined}
      rel={primary ? 'noreferrer' : undefined}
      aria-label={primary ? `Open ${project.title}` : `Read ${project.title} case notes`}
      data-live-link={primary?.kind === 'live' ? true : undefined}
      data-cursor-text={primary?.kind === 'live' ? 'LIVE ↗' : 'OPEN'}
    >
      <ProductPreview project={project} compact />
      <span class="project-preview-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</article>
