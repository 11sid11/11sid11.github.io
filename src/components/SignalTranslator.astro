<div class="signal-translator" data-signal-translator aria-hidden="true">
  <div class="signal-translator-topline">
    <span>LIVE TRANSLATION</span>
    <span class="signal-status">SYSTEM READY</span>
  </div>

  <div class="signal-board">
    <div class="signal-node signal-input">
      <span>INPUT</span>
      <div class="signal-state-stack">
        <strong class="signal-state signal-state-default">PROBLEM</strong>
        <strong class="signal-state signal-state-dev">FRICTION</strong>
        <strong class="signal-state signal-state-creative">NOISE</strong>
      </div>
    </div>

    <div class="signal-route">
      <i></i><i></i><i></i>
      <span>→</span>
    </div>

    <div class="signal-node signal-output">
      <span>OUTPUT</span>
      <div class="signal-state-stack">
        <strong class="signal-state signal-state-default">USEFUL THING</strong>
        <strong class="signal-state signal-state-dev">SYSTEM</strong>
        <strong class="signal-state signal-state-creative">SIGNAL</strong>
      </div>
    </div>
  </div>

  <div class="signal-translator-footer">
    <span>ONE INSTINCT</span>
    <span>DEV / CREATIVE</span>
  </div>
</div>
