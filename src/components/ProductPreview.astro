---
import type { DevProject } from '@/data/projects';

interface Props {
  project: DevProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { slug, title, preview } = project;
---
<div class:list={['product-preview', `preview-${slug}`, compact && 'is-compact']} aria-hidden="true">
  <div class="preview-browserbar">
    <span></span><span></span><span></span>
    <div class="preview-url">{preview.address}</div>
  </div>

  <div class="preview-stage">
    {preview.src ? (
      <img
        class="product-preview-image"
        src={preview.src}
        alt=""
        loading="lazy"
        decoding="async"
        width="1280"
        height="800"
      />
    ) : (
      <div class="private-preview">
        <span class="private-preview-status">IN PROGRESS</span>
        <strong>{title}</strong>
        <p>A private prototype for diet, training and everyday decisions.</p>
        <div class="private-preview-track"><i></i></div>
        <span class="private-preview-note">DETAILS LIMITED</span>
      </div>
    )}
  </div>

  <div class="preview-caption">
    <span>{title}</span>
    <span>{preview.src ? 'PROJECT SCREENSHOT' : 'PRIVATE PREVIEW'}</span>
  </div>
</div>
