<figure class="ascii-sculpture" data-ascii-sculpture aria-label="Interactive typographic sculpture connecting code and visual work">
  <div class="ascii-sculpture-field">
    <canvas class="ascii-sculpture-canvas" data-ascii-canvas aria-hidden="true"></canvas>
    <div class="ascii-sculpture-fallback" data-ascii-fallback aria-hidden="true">
      <span>CODE</span><i>×</i><span>FRAME</span>
    </div>
  </div>
  <figcaption>
    <span>CODE / SOFTWARE</span>
    <span class="ascii-sculpture-instruction">DRAG TO ROTATE</span>
    <span>FRAME / VISUAL</span>
  </figcaption>
</figure>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-ascii-sculpture]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const glyphs = '·:+*#@';

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.asciiReady) return;
      const canvas = root.querySelector('[data-ascii-canvas]');
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext('2d');
      if (!context) return;

      let width = 1;
      let height = 1;
      let points = [];
      let yaw = 0.78;
      let pitch = -0.18;
      let targetYaw = yaw;
      let targetPitch = pitch;
      let idleYaw = yaw;
      let visible = true;
      let dragging = false;
      let lastX = 0;
      let lastY = 0;
      let previousTime = 0;
      let lastFrame = 0;
      let animationFrame = 0;

      const makeTextPlane = (word, plane) => {
        const mask = document.createElement('canvas');
        mask.width = 560;
        mask.height = 170;
        const maskContext = mask.getContext('2d', { willReadFrequently: true });
        if (!maskContext) return [];
        maskContext.clearRect(0, 0, mask.width, mask.height);
        maskContext.fillStyle = '#fff';
        maskContext.font = '950 126px Arial, sans-serif';
        maskContext.textAlign = 'center';
        maskContext.textBaseline = 'middle';
        maskContext.fillText(word, mask.width / 2, mask.height / 2 + 4);
        const pixels = maskContext.getImageData(0, 0, mask.width, mask.height).data;
        const sampled = [];
        const step = word === 'FRAME' ? 8 : 7;
        for (let y = 0; y < mask.height; y += step) {
          for (let x = 0; x < mask.width; x += step) {
            if (pixels[(y * mask.width + x) * 4 + 3] < 110) continue;
            const normalizedX = (x / mask.width - 0.5) * 4.2;
            const normalizedY = (y / mask.height - 0.5) * 1.35;
            sampled.push(plane === 0
              ? { x: normalizedX, y: normalizedY - 0.22, z: 0, plane }
              : { x: 0, y: normalizedY + 0.22, z: -normalizedX, plane });
          }
        }
        return sampled;
      };

      const buildPoints = () => {
        const combined = [...makeTextPlane('CODE', 0), ...makeTextPlane('FRAME', 1)];
        const stride = Math.max(1, Math.ceil(combined.length / 1500));
        points = combined.filter((_, index) => index % stride === 0).slice(0, 1500);
        root.dataset.asciiPoints = String(points.length);
      };

      const requestParticlePaint = () => {
        const source = root.closest('canvas[layoutsubtree]');
        if (source && typeof source.requestPaint === 'function') source.requestPaint();
      };

      const draw = () => {
        context.clearRect(0, 0, width, height);
        const scaleBase = Math.min(width, height) * 0.24;
        const cosineY = Math.cos(yaw);
        const sineY = Math.sin(yaw);
        const cosineX = Math.cos(pitch);
        const sineX = Math.sin(pitch);
        const projected = [];

        points.forEach((point) => {
          const rotatedX = point.x * cosineY - point.z * sineY;
          const firstZ = point.x * sineY + point.z * cosineY;
          const rotatedY = point.y * cosineX - firstZ * sineX;
          const rotatedZ = point.y * sineX + firstZ * cosineX;
          const perspective = 4.8 / Math.max(2.2, 4.8 - rotatedZ);
          projected.push({
            x: width * 0.5 + rotatedX * scaleBase * perspective,
            y: height * 0.5 + rotatedY * scaleBase * perspective,
            z: rotatedZ,
            plane: point.plane,
            perspective,
          });
        });

        projected.sort((a, b) => a.z - b.z);
        projected.forEach((point) => {
          const depth = Math.max(0, Math.min(1, (point.z + 2.5) / 5));
          const glyph = glyphs[Math.min(glyphs.length - 1, Math.floor(depth * glyphs.length))];
          const alpha = 0.3 + depth * 0.7;
          context.font = `${Math.max(8, 10.5 * point.perspective)}px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;
          context.fillStyle = point.plane === 0
            ? `rgba(201,245,54,${alpha})`
            : `rgba(255,90,54,${alpha})`;
          context.fillText(glyph, point.x, point.y);
        });
        requestParticlePaint();
      };

      const resize = () => {
        const rect = root.getBoundingClientRect();
        const ratio = Math.min(2, window.devicePixelRatio || 1);
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(root.querySelector('.ascii-sculpture-field')?.clientHeight || rect.height));
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        draw();
      };

      const render = (time) => {
        animationFrame = requestAnimationFrame(render);
        if (reducedMotion || document.hidden || !visible || time - lastFrame < 32) return;
        const delta = Math.min(48, Math.max(0, time - previousTime));
        previousTime = time;
        lastFrame = time;
        if (!dragging) {
          idleYaw += delta * 0.000055;
          if (!root.matches(':hover')) targetYaw = idleYaw;
        }
        yaw += (targetYaw - yaw) * 0.075;
        pitch += (targetPitch - pitch) * 0.075;
        draw();
      };

      root.addEventListener('pointermove', (event) => {
        const rect = root.getBoundingClientRect();
        if (dragging) {
          targetYaw += (event.clientX - lastX) * 0.008;
          targetPitch = Math.max(-0.65, Math.min(0.65, targetPitch + (event.clientY - lastY) * 0.006));
        } else {
          const x = (event.clientX - rect.left) / Math.max(1, rect.width) - 0.5;
          const y = (event.clientY - rect.top) / Math.max(1, rect.height) - 0.5;
          targetYaw = idleYaw + x * 0.48;
          targetPitch = -0.18 - y * 0.34;
        }
        lastX = event.clientX;
        lastY = event.clientY;
      }, { passive: true });

      root.addEventListener('pointerdown', (event) => {
        if (reducedMotion) return;
        dragging = true;
        lastX = event.clientX;
        lastY = event.clientY;
        root.setPointerCapture?.(event.pointerId);
        root.classList.add('is-dragging');
      });

      const release = (event) => {
        dragging = false;
        root.releasePointerCapture?.(event.pointerId);
        root.classList.remove('is-dragging');
      };
      root.addEventListener('pointerup', release);
      root.addEventListener('pointercancel', release);
      root.addEventListener('pointerleave', () => {
        if (!dragging) targetPitch = -0.18;
      });

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(root);
      const intersectionObserver = new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      }, { rootMargin: '120px' });
      intersectionObserver.observe(root);

      buildPoints();
      root.dataset.asciiReady = 'true';
      root.classList.add('is-ready');
      resize();
      if (reducedMotion) draw();
      else animationFrame = requestAnimationFrame(render);

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
      }, { once: true });
    });
  })();
</script>
