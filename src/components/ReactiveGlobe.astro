<figure class="reactive-globe" data-reactive-globe aria-label="Interactive globe representing software and visual work">
  <div class="reactive-globe-field">
    <canvas data-globe-canvas aria-hidden="true"></canvas>
    <div class="reactive-globe-fallback" aria-hidden="true">◎</div>
  </div>
  <figcaption>
    <span>SOFTWARE / SYSTEMS</span>
    <span class="reactive-globe-instruction">DRAG TO ORBIT</span>
    <span>VISUAL / MOTION</span>
  </figcaption>
</figure>

<script is:inline>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-reactive-globe]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.globeReady) return;
      const canvas = root.querySelector('[data-globe-canvas]');
      const field = root.querySelector('.reactive-globe-field');
      if (!(canvas instanceof HTMLCanvasElement) || !(field instanceof HTMLElement)) return;
      const context = canvas.getContext('2d');
      if (!context) return;

      let width = 1;
      let height = 1;
      let radius = 1;
      let yaw = -0.45;
      let pitch = -0.2;
      let targetYaw = yaw;
      let targetPitch = pitch;
      let dragging = false;
      let visible = true;
      let lastX = 0;
      let lastY = 0;
      let lastFrame = 0;
      let animationFrame = 0;
      let glow = null;

      const rotate = (x, y, z) => {
        const cosY = Math.cos(yaw);
        const sinY = Math.sin(yaw);
        const cosX = Math.cos(pitch);
        const sinX = Math.sin(pitch);
        const rotatedX = x * cosY - z * sinY;
        const firstZ = x * sinY + z * cosY;
        return {
          x: rotatedX,
          y: y * cosX - firstZ * sinX,
          z: y * sinX + firstZ * cosX,
        };
      };

      const project = (point) => ({
        x: width * 0.5 + point.x * radius,
        y: height * 0.49 + point.y * radius,
        z: point.z,
      });

      const drawCurve = (pointAt, segments, color, alpha = 1) => {
        context.beginPath();
        for (let index = 0; index <= segments; index += 1) {
          const point = project(rotate(...pointAt(index / segments)));
          if (index === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        }
        context.globalAlpha = alpha;
        context.strokeStyle = color;
        context.stroke();
      };

      const requestParticlePaint = () => {
        const source = root.closest('canvas[layoutsubtree]');
        if (source && typeof source.requestPaint === 'function') source.requestPaint();
      };

      const draw = () => {
        context.clearRect(0, 0, width, height);
        context.save();
        context.lineWidth = 0.8;
        context.lineCap = 'round';

        if (glow) {
          context.globalAlpha = 0.42;
          context.fillStyle = glow;
          context.beginPath();
          context.arc(width * 0.5, height * 0.49, radius * 1.28, 0, Math.PI * 2);
          context.fill();
        }

        for (let latitude = -60; latitude <= 60; latitude += 20) {
          const angle = latitude * Math.PI / 180;
          const ringRadius = Math.cos(angle);
          const y = Math.sin(angle);
          drawCurve((progress) => {
            const longitude = progress * Math.PI * 2;
            return [Math.cos(longitude) * ringRadius, y, Math.sin(longitude) * ringRadius];
          }, 48, latitude < 0 ? '#ff5a36' : '#c9f536', 0.26);
        }

        for (let longitude = 0; longitude < 12; longitude += 1) {
          const angle = longitude / 12 * Math.PI * 2;
          drawCurve((progress) => {
            const latitude = (progress - 0.5) * Math.PI;
            return [Math.cos(latitude) * Math.cos(angle), Math.sin(latitude), Math.cos(latitude) * Math.sin(angle)];
          }, 42, longitude % 2 ? '#ff5a36' : '#c9f536', 0.34);
        }

        context.globalAlpha = 0.72;
        context.lineWidth = 1.15;
        context.strokeStyle = '#f1efe7';
        context.beginPath();
        context.ellipse(width * 0.5, height * 0.49, radius * 1.04, radius, 0, 0, Math.PI * 2);
        context.stroke();

        const satelliteAngle = yaw * 1.7;
        const satelliteX = width * 0.5 + Math.cos(satelliteAngle) * radius * 1.18;
        const satelliteY = height * 0.49 + Math.sin(satelliteAngle) * radius * 0.36;
        context.globalAlpha = 1;
        context.fillStyle = '#c9f536';
        context.beginPath();
        context.arc(satelliteX, satelliteY, 3.2, 0, Math.PI * 2);
        context.fill();

        context.restore();
        requestParticlePaint();
      };

      const resize = () => {
        const rect = field.getBoundingClientRect();
        const ratio = Math.min(2, window.devicePixelRatio || 1);
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        radius = Math.min(width, height) * 0.35;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        glow = context.createRadialGradient(width * 0.5, height * 0.49, 0, width * 0.5, height * 0.49, radius * 1.28);
        glow.addColorStop(0, 'rgba(201,245,54,.08)');
        glow.addColorStop(0.55, 'rgba(255,90,54,.035)');
        glow.addColorStop(1, 'rgba(0,0,0,0)');
        draw();
      };

      const render = (time) => {
        animationFrame = requestAnimationFrame(render);
        const frameInterval = document.documentElement.classList.contains('particle-scroll-active') ? 66 : 40;
        if (reducedMotion || document.hidden || !visible || time - lastFrame < frameInterval) return;
        lastFrame = time;
        if (!dragging && !root.matches(':hover')) targetYaw += 0.004;
        yaw += (targetYaw - yaw) * 0.09;
        pitch += (targetPitch - pitch) * 0.09;
        draw();
      };

      root.addEventListener('pointermove', (event) => {
        const rect = root.getBoundingClientRect();
        if (dragging) {
          targetYaw += (event.clientX - lastX) * 0.009;
          targetPitch = Math.max(-0.7, Math.min(0.7, targetPitch + (event.clientY - lastY) * 0.007));
        } else {
          targetYaw += (((event.clientX - rect.left) / Math.max(1, rect.width) - 0.5) * 0.6 + yaw - targetYaw) * 0.18;
          targetPitch = -0.2 - ((event.clientY - rect.top) / Math.max(1, rect.height) - 0.5) * 0.3;
        }
        lastX = event.clientX;
        lastY = event.clientY;
      }, { passive: true });

      root.addEventListener('pointerdown', (event) => {
        if (reducedMotion) return;
        dragging = true;
        lastX = event.clientX;
        lastY = event.clientY;
        root.setPointerCapture?.(event.pointerId);
        root.classList.add('is-dragging');
      });

      const release = (event) => {
        dragging = false;
        root.releasePointerCapture?.(event.pointerId);
        root.classList.remove('is-dragging');
      };
      root.addEventListener('pointerup', release);
      root.addEventListener('pointercancel', release);

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(field);
      const intersectionObserver = new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      }, { rootMargin: '120px' });
      intersectionObserver.observe(root);

      root.dataset.globeReady = 'true';
      resize();
      if (reducedMotion) draw();
      else animationFrame = requestAnimationFrame(render);

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
      }, { once: true });
    });
  })();
</script>
