---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreativeCard from '@/components/CreativeCard.astro';
import { creativeWork } from '@/data/creative';

const gaming = creativeWork.find((work) => work.slug === 'gaming-thumbnails');
const rest = creativeWork.filter((work) => work.slug !== 'gaming-thumbnails');
---
<BaseLayout
  title="Creative — Siddharth Sahoo"
  description="Video editing, gaming thumbnails, brand content and visual work by Siddharth Sahoo."
  pageClass="creative-page"
>
  <header class="page-hero page-hero-v2 creative-hero-v2" data-scroll-progress="viewport">
    <span class="kicker">02 / Creative</span>
    <h1>Hold the attention.</h1>
    <div class="page-hero-copy">
      <div class="micro">EDITING / GAMING / THUMBNAILS / SOCIAL / VISUAL SYSTEMS</div>
      <p>I edit and design for screens where the viewer can leave instantly. The job is not to make every second louder. It is to know what deserves the eye next.</p>
    </div>
  </header>

  {gaming && gaming.media.length > 0 && (
    <section class="creative-scroll-feature" data-scroll-progress="section" aria-labelledby="gaming-feature-title">
      <div class="creative-scroll-stage">
        <div class="creative-scroll-copy">
          <span class="kicker">01 / YouTube + gaming</span>
          <h2 id="gaming-feature-title">Readable<br/>at feed<br/>speed.</h2>
          <p>Subject separation, lighting, typography and supporting detail. The point is not “more effects.” It is making the promise clear before the viewer scrolls past.</p>
          <a href="/creative/gaming-thumbnails/" class="text-link" data-case-link>CASE NOTES →</a>
        </div>

        <div class="creative-scroll-media" data-media-link data-cursor-text="VIEW">
          <div class="creative-frame-stack">
            {gaming.media.map((media, index) => (
              <figure class:list={['creative-frame', `creative-frame-${index + 1}`]}>
                <img src={media.src} alt={media.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="1027" height="578" />
              </figure>
            ))}
          </div>
          <div class="creative-frame-index" aria-hidden="true">
            <span>01</span><span>02</span><span>03</span>
          </div>
          <div class="creative-detail creative-detail-one" aria-hidden="true">
            <img src={gaming.media[0].src} alt="" loading="lazy" decoding="async" width="1027" height="578" />
          </div>
          {gaming.media[1] && (
            <div class="creative-detail creative-detail-two" aria-hidden="true">
              <img src={gaming.media[1].src} alt="" loading="lazy" decoding="async" width="1027" height="578" />
            </div>
          )}
          <div class="creative-feature-notes" aria-hidden="true">
            <span>FOCAL HIERARCHY</span>
            <span>TYPE / LIGHT / SEPARATION</span>
            <span>CLICK-READABLE FIRST</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section creative-rest-section">
    <div class="shell">
      <div class="section-head kinetic-head" data-scroll-progress="viewport">
        <div><span class="kicker">Editing / brand / experiments</span></div>
        <div>
          <h2>Pace first. Decoration second.</h2>
          <p class="section-intro">I cut the drag before adding another zoom. Then I use motion, sound, subtitles and visual resets where they actually buy attention back.</p>
        </div>
      </div>
      <div class="creative-grid creative-grid-v2">
        {rest.map((work, index) => <CreativeCard work={work} index={index + 1} />)}
      </div>
    </div>
  </section>

  <section class="creative-process" data-scroll-progress="section" aria-label="Editing process">
    <div class="creative-process-stage">
      <div class="creative-process-track" aria-hidden="true">CUT / RESET / RETAIN / CUT / RESET / RETAIN /</div>
      <div class="shell creative-process-grid">
        <article>
          <span class="step">01 / CUT</span>
          <h3>Remove the drag.</h3>
          <p>Slow intros, repetitive sequences, menu navigation and points already understood disappear before decoration starts.</p>
        </article>
        <article>
          <span class="step">02 / RESET</span>
          <h3>Change the rhythm.</h3>
          <p>Subtitles, memes, reframes, sound and motion work as attention resets precisely because they are not constant.</p>
        </article>
        <article>
          <span class="step">03 / SHIP</span>
          <h3>Move quickly. Look deliberate.</h3>
          <p>Clear briefs can reach first draft in roughly 24 hours. DaVinci Resolve, reusable project setups and a clear review path make that turnaround possible.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="contact-band creative-contact" aria-label="Creative work contact">
    <div>
      <span class="kicker">Available / selective work</span>
      <h2>Need something people keep watching?</h2>
      <p>Gaming, YouTube, Shorts, thumbnails and branded social work. Send the footage or the problem; that is usually enough to start.</p>
      <div class="contact-actions">
        <a class="cta-button creative-cta" href="https://x.com/sid_flac" target="_blank" rel="noreferrer">Work with me on X ↗</a>
        <a class="cta-button creative-cta" href="https://discord.com/users/456027988417314816" target="_blank" rel="noreferrer">Discord ↗</a>
      </div>
    </div>
    <div>
      <span class="kicker">More work</span>
      <h2>See ongoing work on Instagram.</h2>
      <p>Personal work and smaller visual experiments appear there between larger portfolio updates.</p>
      <div class="contact-actions">
        <a class="cta-button creative-cta" href="https://www.instagram.com/sid.flac/" target="_blank" rel="noreferrer">@sid.flac ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
