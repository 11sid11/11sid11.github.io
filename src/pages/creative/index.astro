---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreativeCard from '@/components/CreativeCard.astro';
import { creativeWork } from '@/data/creative';
---
<BaseLayout
  title="Creative — Siddharth Sahoo"
  description="Video editing, gaming thumbnails, brand content and visual work by Siddharth Sahoo."
  pageClass="creative-page"
>
  <header class="page-hero">
    <span class="kicker">02 / Creative</span>
    <h1>Hold the attention.</h1>
    <div class="page-hero-copy">
      <div class="micro">EDITING / GAMING / THUMBNAILS / SOCIAL / VISUAL SYSTEMS</div>
      <p>I edit and design for screens where the viewer can leave instantly. The job is not to make every second louder. It is to know which seconds are allowed to be quiet.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><span class="kicker">Selected work</span></div>
        <div>
          <h2>Made for the feed. Not owned by it.</h2>
          <p class="section-intro">Gaming thumbnails, retention-focused editing, brand work and visual experiments. No embedded social feed; the work gets to use its own space here.</p>
        </div>
      </div>
      <div class="creative-grid">
        {creativeWork.map((work, index) => <CreativeCard work={work} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><span class="kicker">Editing approach</span></div>
        <div>
          <h2>Retention is a pacing problem first.</h2>
          <p class="section-intro">Slow intros, menu navigation, repetitive sequences, dead air and points already made twice are usually where attention leaks. I cut there before adding another zoom.</p>
        </div>
      </div>
      <div class="process-grid">
        <article class="process-item" data-reveal>
          <span class="step">01 / CUT</span>
          <h3>Remove the drag.</h3>
          <p>Keep the personality. Lose the parts the viewer has already understood, predicted, or stopped caring about.</p>
        </article>
        <article class="process-item" data-reveal>
          <span class="step">02 / RESET</span>
          <h3>Change the visual rhythm.</h3>
          <p>Subtitles, sound, memes, reframes and motion are attention resets. They work better when they are not constant.</p>
        </article>
        <article class="process-item" data-reveal>
          <span class="step">03 / SHIP</span>
          <h3>Move quickly without looking rushed.</h3>
          <p>Clear briefs can reach first draft in roughly 24 hours. DaVinci Resolve and an AI-assisted workflow handle speed; judgment handles the edit.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="contact-band" aria-label="Creative work contact">
    <div data-reveal>
      <span class="kicker">Available / selective work</span>
      <h2>Need something people keep watching?</h2>
      <p>Gaming, YouTube, Shorts, thumbnails and branded social work. Send the footage or the problem; that is usually enough to start.</p>
      <div class="contact-actions">
        <a class="cta-button" href="https://x.com/sid_flac" target="_blank" rel="noreferrer">Work with me on X ↗</a>
        <a class="cta-button" href="https://discord.com/users/456027988417314816" target="_blank" rel="noreferrer">Discord ↗</a>
      </div>
    </div>
    <div data-reveal>
      <span class="kicker">More fragments</span>
      <h2>The archive is larger than this page.</h2>
      <p>Personal work and ongoing visual experiments also show up on Instagram. I keep this portfolio tighter on purpose.</p>
      <div class="contact-actions">
        <a class="cta-button" href="https://www.instagram.com/sid.flac/" target="_blank" rel="noreferrer">@sid.flac ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
