---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, smallerProjects } from '@/data/projects';
---
<BaseLayout
  title="Dev — Siddharth Sahoo"
  description="Software, open-source tools, automations and product work by Siddharth Sahoo."
  pageClass="dev-page"
>
  <header class="page-hero">
    <span class="kicker">01 / Developer</span>
    <h1>Build the system.</h1>
    <div class="page-hero-copy">
      <div class="micro">LOCAL-FIRST / AUTOMATION / WEB / BROWSER TOOLS / PRODUCT</div>
      <p>I build software that removes friction: apps that work without an account, automations that live close to the user, and products with enough structure to survive past the demo.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><span class="kicker">Featured work</span></div>
        <div>
          <h2>Selected builds.</h2>
          <p class="section-intro">Public source where it makes sense. Product-level showcases where it does not. No private repository cosplay.</p>
        </div>
      </div>
      <div class="project-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><span class="kicker">How I work</span></div>
        <div>
          <h2>AI in the loop. Judgment still required.</h2>
          <p class="section-intro">Claude and Codex are part of the workflow now. I use them for throughput, investigation, iteration and review—not as a substitute for architecture, testing or knowing what the product is supposed to do.</p>
        </div>
      </div>
      <div class="process-grid">
        <article class="process-item" data-reveal>
          <span class="step">01 / DEFINE</span>
          <h3>Find the actual boundary.</h3>
          <p>What is source of truth? What should remain local? What can fail? What should never be silently coupled?</p>
        </article>
        <article class="process-item" data-reveal>
          <span class="step">02 / BUILD</span>
          <h3>Use tools aggressively.</h3>
          <p>AI assists implementation and exploration; small modules, typed interfaces, tests and documentation keep the speed from becoming debt.</p>
        </article>
        <article class="process-item" data-reveal>
          <span class="step">03 / VERIFY</span>
          <h3>Make the boring paths real.</h3>
          <p>Backups, updates, failure states, migration, privacy boundaries and cleanup are product work—not the part after product work.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><span class="kicker">Smaller / useful</span></div>
        <div>
          <h2>Not every tool needs a manifesto.</h2>
          <p class="section-intro">Some projects exist because a narrow problem needed a reliable answer.</p>
        </div>
      </div>
      <div class="small-projects">
        {smallerProjects.map((project) => (
          <a class="small-project" href={project.href} target="_blank" rel="noreferrer" data-reveal>
            <h3>{project.title}</h3>
            <div>
              <p>{project.summary}</p>
              <span class="text-link">Source ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
